{
  "manifest_version": 3,
  "name": "Profile Capture Prototype",
  "version": "0.1.0",
  "description": "MV3 prototype: DOM capture, review, mock or live POST from service worker.",
  "action": {
    "default_title": "Profile Capture Prototype",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting", "cookies"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://sandbox.platform.xenhirely.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sandbox.platform.xenhirely.com/*"
      ],
      "js": [
        "xenhirely-auth.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": [
        "functions/helpers.js",
        "functions/experience.js",
        "functions/education.js",
        "functions/company.js",
        "functions/activity.js",
        "functions/connections.js",
        "functions/misc-scrapers.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
